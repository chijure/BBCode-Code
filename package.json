{
  "name": "bbcode-support",
  "displayName": "BBCode",
  "description": "Extensión de Visual Studio Code para dar soporte básico a archivos BBCode con resaltado de sintaxis y pares de caracteres automáticos.",
  "version": "1.1.0",
  "publisher": "JuanReateguiSolis",
  "license": "MIT",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.75.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chijure/BBCode-Code.git"
  },
  "bugs": {
    "url": "https://github.com/chijure/BBCode-Code/issues"
  },
  "homepage": "https://github.com/chijure/BBCode-Code#readme",
  "icon": "images/icon.png",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "bbcode",
    "forum",
    "markup",
    "phpbb",
    "vbulletin",
    "preview",
    "renderer"
  ],
  "activationEvents": [
    "onLanguage:bbcode",
    "onCommand:bbcode.preview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bbcode",
        "aliases": [
          "BBCode",
          "bbcode"
        ],
        "extensions": [
          ".bbcode"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bbcode",
        "scopeName": "source.bbcode",
        "path": "./syntaxes/bbcode.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "bbcode.preview",
        "title": "BBCode: Vista previa",
        "category": "BBCode",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bbcode.preview",
          "group": "navigation",
          "when": "editorLangId == bbcode"
        }
      ]
    },
    "configuration": {
      "title": "BBCode",
      "properties": {
        "bbcode.preview.mentionUrl": {
          "type": "string",
          "default": "https://xdaforums.com/member.php?u={id}",
          "markdownDescription": "URL usada para `[MENTION=id]` y `[USER=id]`. `{id}` se reemplaza por el id del usuario. Vacío para no generar enlaces."
        }
      }
    },
    "keybindings": [
      {
        "command": "bbcode.preview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == bbcode"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
