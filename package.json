{
  "name": "bbcode-support",
  "displayName": "BBCode",
  "description": "Soporte BBCode para VS Code: vista previa compatible con XDA/XenForo y phpBB, avisos de etiquetas mal cerradas, autocompletado, atajos de formato y snippets.",
  "version": "1.2.0",
  "publisher": "JuanReateguiSolis",
  "license": "MIT",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.75.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chijure/BBCode-Code.git"
  },
  "bugs": {
    "url": "https://github.com/chijure/BBCode-Code/issues"
  },
  "homepage": "https://github.com/chijure/BBCode-Code#readme",
  "icon": "images/icon.png",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "bbcode",
    "forum",
    "markup",
    "phpbb",
    "vbulletin",
    "preview",
    "renderer",
    "xda",
    "xenforo",
    "snippets"
  ],
  "activationEvents": [
    "onLanguage:bbcode",
    "onCommand:bbcode.preview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bbcode",
        "aliases": [
          "BBCode",
          "bbcode"
        ],
        "extensions": [
          ".bbcode"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bbcode",
        "scopeName": "source.bbcode",
        "path": "./syntaxes/bbcode.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "bbcode.preview",
        "title": "BBCode: Vista previa",
        "category": "BBCode",
        "icon": "$(open-preview)"
      },
      {
        "command": "bbcode.toggleTag",
        "title": "Alternar etiqueta",
        "category": "BBCode"
      },
      {
        "command": "bbcode.insertLink",
        "title": "Insertar enlace",
        "category": "BBCode"
      },
      {
        "command": "bbcode.preview.changeTheme",
        "title": "Cambiar estilo de la vista previa",
        "category": "BBCode",
        "icon": "$(symbol-color)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bbcode.preview",
          "group": "navigation",
          "when": "editorLangId == bbcode"
        },
        {
          "command": "bbcode.preview.changeTheme",
          "group": "navigation",
          "when": "activeWebviewPanelId == bbcodePreview"
        }
      ],
      "commandPalette": [
        {
          "command": "bbcode.toggleTag",
          "when": "editorLangId == bbcode"
        },
        {
          "command": "bbcode.insertLink",
          "when": "editorLangId == bbcode"
        }
      ]
    },
    "configuration": {
      "title": "BBCode",
      "properties": {
        "bbcode.preview.mentionUrl": {
          "type": "string",
          "default": "https://xdaforums.com/member.php?u={id}",
          "markdownDescription": "URL usada para `[MENTION=id]` y `[USER=id]`. `{id}` se reemplaza por el id del usuario. Vacío para no generar enlaces."
        },
        "bbcode.validate": {
          "type": "boolean",
          "default": true,
          "description": "Muestra avisos de etiquetas sin cerrar, cierres sin apertura y anidamientos cruzados."
        },
        "bbcode.autoCloseTags": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Al escribir `[/` completa automáticamente el cierre de la última etiqueta abierta."
        },
        "bbcode.tagCase": {
          "type": "string",
          "enum": [
            "auto",
            "upper",
            "lower"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Usa el estilo que predomina en el documento (mayúsculas si no hay etiquetas).",
            "Siempre en mayúsculas, como XDA: [B].",
            "Siempre en minúsculas, como phpBB: [b]."
          ],
          "description": "Mayúsculas o minúsculas en las etiquetas que inserta la extensión."
        },
        "bbcode.preview.theme": {
          "type": "string",
          "enum": [
            "xda",
            "xda-dark",
            "xda-light",
            "xda-classic",
            "vscode"
          ],
          "default": "xda",
          "enumDescriptions": [
            "Estilo de XDA Forums: oscuro o claro según el tema de VS Code.",
            "XDA Dark.",
            "XDA Theme (claro).",
            "XDA Classic.",
            "Solo el contenido, con los colores del tema de VS Code."
          ],
          "description": "Estilo de la vista previa."
        },
        "bbcode.preview.xdaLineBreaks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Muestra los saltos de línea como los deja el editor de XDA: una línea en blanco entre párrafos se convierte en un solo salto. No aplica al estilo `vscode`."
        }
      }
    },
    "keybindings": [
      {
        "command": "bbcode.preview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == bbcode"
      },
      {
        "command": "bbcode.toggleTag",
        "args": {
          "tag": "B"
        },
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == bbcode"
      },
      {
        "command": "bbcode.toggleTag",
        "args": {
          "tag": "I"
        },
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == bbcode"
      },
      {
        "command": "bbcode.toggleTag",
        "args": {
          "tag": "U"
        },
        "key": "ctrl+u",
        "mac": "cmd+u",
        "when": "editorTextFocus && editorLangId == bbcode"
      },
      {
        "command": "bbcode.insertLink",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && editorLangId == bbcode"
      }
    ],
    "snippets": [
      {
        "language": "bbcode",
        "path": "./snippets/bbcode.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
